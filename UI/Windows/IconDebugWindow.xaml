<Window x:Class="minimal_switcher.IconDebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Icon Debug"
        Width="980"
        Height="680"
        MinWidth="860"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D10">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#0F1319" />
        <SolidColorBrush x:Key="BorderSoft" Color="#202633" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F6F8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AEB3BC" />

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="ImageFrame" TargetType="Border">
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="#0A0C10" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="#EEF1F6" />
            <Setter Property="Foreground" Value="#0B0D10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="13" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Icon Debug"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="PathText"
                           Text="Carga una imagen, .exe o .dll para inspeccionar la mascara."
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cargar archivo" Click="OpenFileButton_Click" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <TextBlock Text="Apps"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   DockPanel.Dock="Left" />
                        <Button Content="Refrescar"
                                DockPanel.Dock="Right"
                                Click="RefreshWindowsButton_Click" />
                    </DockPanel>
                    <ListBox x:Name="WindowsList"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionChanged="WindowsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        CornerRadius="14"
                                        Background="#0A0C10"
                                        BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1"
                                        Padding="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Source="{Binding Icon}"
                                               Width="26"
                                               Height="26"
                                               VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding AppName}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource ImageFrame}">
                    <StackPanel>
                        <TextBlock Text="Normalizado 128px" FontWeight="SemiBold" />
                        <Image x:Name="NormalizedImage" Stretch="Uniform" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ImageFrame}">
                    <StackPanel>
                        <TextBlock Text="Mascara candidata" FontWeight="SemiBold" />
                        <Image x:Name="MaskImage" Stretch="Uniform" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource ImageFrame}">
                    <StackPanel>
                        <TextBlock Text="Residuo" FontWeight="SemiBold" />
                        <TextBlock Text="Rojo: falta dentro. Azul: sobra fuera."
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                        <Image x:Name="ResidualImage" Stretch="Uniform" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ImageFrame}">
                    <StackPanel>
                        <TextBlock Text="Resultado" FontWeight="SemiBold" />
                        <Border Width="110"
                                Height="110"
                                Margin="0,14,0,0"
                                CornerRadius="18"
                                Background="#10FFFFFF"
                                BorderBrush="#20FFFFFF"
                                BorderThickness="1">
                            <Image x:Name="ProcessedImage"
                                   Width="88"
                                   Height="88"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <StackPanel>
                    <TextBlock Text="Decision" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="DecisionText"
                               Foreground="{StaticResource TextSecondary}"
                               Margin="0,8,0,18" />
                    <TextBlock x:Name="MetricsText"
                               FontFamily="Consolas"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

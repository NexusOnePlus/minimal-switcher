<Window
    x:Class="minimal_switcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Minimal Switcher"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    SizeToContent="WidthAndHeight"
    MinWidth="200"
    MaxWidth="900"
>
    <Border
        x:Name="WindowFrame"
        CornerRadius="20"
        Background="Transparent"
        BorderBrush="#55FFFFFF"
        BorderThickness="1"
        ClipToBounds="True"
    >
        <Grid x:Name="WindowClipRoot" ClipToBounds="True">
            <Border
                x:Name="GlassyLayer"
                CornerRadius="20"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Border}}"
            />
            <Border
                x:Name="ContentOverlay"
                CornerRadius="20"
                Background="#2A000000"
            />
            <Grid Margin="24,18,24,14">
                <ItemsControl x:Name="IconsPanel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                            />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                HorizontalAlignment="Center"
                                Margin="6,0"
                            >
                                <Border
                                    x:Name="IconBorder"
                                    Width="88"
                                    Height="88"
                                    CornerRadius="14"
                                    Background="#10FFFFFF"
                                    BorderBrush="#20FFFFFF"
                                    BorderThickness="1"
                                    ClipToBounds="True"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="IconBorder_MouseLeftButtonUp"
                                >
                                    <Image
                                        Source="{Binding Icon}"
                                        Width="{Binding IconSize}"
                                        Height="{Binding IconSize}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                    />
                                </Border>
                                <TextBlock
                                    x:Name="ItemTitle"
                                    Text="{Binding Title}"
                                    Width="88"
                                    Margin="0,4,0,0"
                                    Padding="4,0"
                                    FontSize="10"
                                    Foreground="#C0FFFFFF"
                                    TextTrimming="CharacterEllipsis"
                                    TextAlignment="Center"
                                    HorizontalAlignment="Center"
                                />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsSelected}"
                                    Value="False"
                                >
                                    <Setter
                                        TargetName="ItemTitle"
                                        Property="Visibility"
                                        Value="Collapsed"
                                    />
                                </DataTrigger>
                                <DataTrigger
                                    Binding="{Binding IsSelected}"
                                    Value="True"
                                >
                                    <Setter
                                        TargetName="IconBorder"
                                        Property="Background"
                                        Value="#38FFFFFF"
                                    />
                                    <Setter
                                        TargetName="IconBorder"
                                        Property="BorderBrush"
                                        Value="#80FFFFFF"
                                    />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Border>
</Window>

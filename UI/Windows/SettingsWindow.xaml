<Window x:Class="minimal_switcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuracion"
        Width="820"
        Height="620"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#0B0D10" />
        <SolidColorBrush x:Key="SurfaceRaised" Color="#0F1319" />
        <SolidColorBrush x:Key="SurfaceInteractive" Color="#12151B" />
        <SolidColorBrush x:Key="BorderSoft" Color="#202633" />
        <SolidColorBrush x:Key="BorderStrong" Color="#3A4353" />
        <SolidColorBrush x:Key="TextPrimary" Color="#F5F6F8" />
        <SolidColorBrush x:Key="TextSecondary" Color="#AEB3BC" />
        <SolidColorBrush x:Key="TextMuted" Color="#737A86" />

        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="38"
                          ShadowDepth="16"
                          Opacity="0.34"
                          Color="#000000" />

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#12151B" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="17" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2028" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
            <Setter Property="Background" Value="{StaticResource SurfaceInteractive}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                CornerRadius="13"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1B2028" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BorderStrong}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="138" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                CornerRadius="16"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="15"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#121820" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#1E2834" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF1F6" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#EEF1F6" />
                                <Setter Property="Foreground" Value="#0B0D10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="RadioButton">
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root"
                                CornerRadius="14"
                                Background="#0A0D12"
                                BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#151A22" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F5F6F8" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#F5F6F8" />
                                <Setter Property="Foreground" Value="#0B0D10" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PresetTileButton" TargetType="Button">
            <Setter Property="Height" Value="92" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <ContentPresenter />
                            <Border x:Name="HoverRing"
                                    CornerRadius="22"
                                    BorderBrush="#70FFFFFF"
                                    BorderThickness="1"
                                    Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverRing" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.975" ScaleY="0.975" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource CleanListBoxItem}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        </Style>

        <Style x:Key="DiscreteScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                CornerRadius="4"
                                Background="#3A4353"
                                Opacity="0.72" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#596273" />
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbRoot" Property="Background" Value="#788294" />
                                <Setter TargetName="ThumbRoot" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DiscreteScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DiscreteScrollBarThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource DiscreteScrollBar}" />

        <Style x:Key="DiscreteScrollViewer" TargetType="ScrollViewer">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                            </Grid.ColumnDefinitions>
                            <ScrollContentPresenter Grid.Column="0"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Style="{StaticResource DiscreteScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="8"
                                    CornerRadius="4"
                                    Background="#1B2028"
                                    BorderBrush="#2B3340"
                                    BorderThickness="1"
                                    VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24" Height="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="#F5F6F8"
                                                             Stroke="#87909F"
                                                             StrokeThickness="1" />
                                                    <Ellipse Width="7"
                                                             Height="7"
                                                             Fill="#0B0D10"
                                                             Opacity="0.45" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="20"
            CornerRadius="30"
            Background="#F00B0D10"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            Effect="{StaticResource WindowShadow}"
            MouseLeftButtonDown="WindowChrome_MouseLeftButtonDown">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Minimal Switcher"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="19"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />

                <Button Content="x"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource CloseButton}"
                        ToolTip="Cerrar"
                        Click="CloseButton_Click" />
            </Grid>

            <Border Grid.Row="2"
                    HorizontalAlignment="Center"
                    CornerRadius="18"
                    Background="#0F1319"
                    BorderBrush="{StaticResource BorderSoft}"
                    BorderThickness="1"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="AppearanceTabButton"
                                 Content="Apariencia"
                                 Tag="&#xE771;"
                                 Style="{StaticResource NavButton}"
                                 GroupName="SettingsTabs"
                                 IsChecked="True"
                                 Checked="TabButton_Checked" />
                    <RadioButton x:Name="IgnoredTabButton"
                                 Content="Ignorados"
                                 Tag="&#xE711;"
                                 Style="{StaticResource NavButton}"
                                 GroupName="SettingsTabs"
                                 Margin="6,0,0,0"
                                 Checked="TabButton_Checked" />
                    <RadioButton x:Name="AboutTabButton"
                                 Content="Acerca de"
                                 Tag="&#xE946;"
                                 Style="{StaticResource NavButton}"
                                 GroupName="SettingsTabs"
                                 Margin="6,0,0,0"
                                 Checked="TabButton_Checked" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <ScrollViewer x:Name="AppearancePanel"
                              Style="{StaticResource DiscreteScrollViewer}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly"
                              CanContentScroll="False">
                    <StackPanel>
                        <Border x:Name="PreviewCard"
                                Width="320"
                                Height="210"
                                CornerRadius="28"
                                Background="#F0000000"
                                BorderBrush="#33FFFFFF"
                                BorderThickness="1"
                                Padding="22"
                                HorizontalAlignment="Center">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <Border Width="78"
                                            Height="78"
                                            CornerRadius="24"
                                            HorizontalAlignment="Center"
                                            Background="#18FFFFFF"
                                            BorderBrush="#33FFFFFF"
                                            BorderThickness="1" />
                                    <TextBlock Text="Preview"
                                               Foreground="#F5F6F8"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               Margin="0,16,0,0" />
                                    <TextBlock Text="Fondo del switcher"
                                               Foreground="#AEB3BC"
                                               FontSize="12"
                                               TextAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1.15*" />
                            </Grid.ColumnDefinitions>

                            <Border CornerRadius="24"
                                    Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Render"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Modo visual"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11"
                                               Margin="0,4,0,14" />
                                    <StackPanel>
                                        <RadioButton x:Name="ShaderModeButton"
                                                     Content="Shader"
                                                     Style="{StaticResource ModeButton}"
                                                     GroupName="ThemeMode"
                                                     Checked="ThemeMode_Checked" />
                                        <RadioButton x:Name="PresetModeButton"
                                                     Content="Tema"
                                                     Style="{StaticResource ModeButton}"
                                                     GroupName="ThemeMode"
                                                     Margin="0,10,0,0"
                                                     Checked="ThemeMode_Checked" />
                                        <RadioButton x:Name="CustomModeButton"
                                                     Content="Custom"
                                                     Style="{StaticResource ModeButton}"
                                                     GroupName="ThemeMode"
                                                     Margin="0,10,0,0"
                                                     Checked="ThemeMode_Checked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2"
                                    CornerRadius="24"
                                    Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Temas"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <ItemsControl x:Name="PresetItems" Margin="0,14,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource PresetTileButton}"
                                                        Tag="{Binding}"
                                                        Click="PresetButton_Click">
                                                    <Border CornerRadius="22"
                                                            Background="{Binding Background}"
                                                            BorderBrush="{Binding Border}"
                                                            BorderThickness="1"
                                                            Padding="13">
                                                        <Grid>
                                                            <Ellipse Width="18"
                                                                     Height="18"
                                                                     Fill="{Binding Accent}"
                                                                     HorizontalAlignment="Right"
                                                                     VerticalAlignment="Top" />
                                                            <TextBlock Text="{Binding Name}"
                                                                       Foreground="#F5F6F8"
                                                                       FontWeight="SemiBold"
                                                                       VerticalAlignment="Bottom" />
                                                        </Grid>
                                                    </Border>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4"
                                    CornerRadius="24"
                                    Background="{StaticResource SurfaceRaised}"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Ajustes"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Color custom"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontWeight="SemiBold"
                                               Margin="0,16,0,8" />
                                    <TextBox x:Name="CustomColorTextBox"
                                             Height="38"
                                             Background="#0A0C10"
                                             BorderBrush="{StaticResource BorderStrong}"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderThickness="1"
                                             Padding="12,7"
                                             TextChanged="CustomColorTextBox_TextChanged" />

                                    <TextBlock Text="Opacidad"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontWeight="SemiBold"
                                               Margin="0,18,0,8" />
                                    <Slider x:Name="OpacitySlider"
                                            Style="{StaticResource ModernSlider}"
                                            Minimum="0"
                                            Maximum="100"
                                            TickFrequency="1"
                                            ValueChanged="OpacitySlider_ValueChanged" />
                                    <Border Height="34"
                                            Margin="0,8,0,0"
                                            CornerRadius="12"
                                            Background="#0A0D12"
                                            BorderBrush="{StaticResource BorderSoft}"
                                            BorderThickness="1"
                                            HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="OpacityValueText"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="IgnoredPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="24"
                            Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Recientes"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Ventanas vistas en esta sesion"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" />
                                </StackPanel>
                                <Button Content="Refrescar"
                                        Style="{StaticResource PillButton}"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right"
                                        Click="RefreshWindowsButton_Click" />
                            </DockPanel>
                            <ListBox x:Name="RecentWindowsList"
                                     Grid.Row="2"
                                     Style="{StaticResource CleanListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                CornerRadius="16"
                                                Background="#0A0C10"
                                                BorderBrush="#17202C"
                                                BorderThickness="1"
                                                Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="74" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AppName}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Ignorar"
                                                        Style="{StaticResource PillButton}"
                                                        Tag="{Binding}"
                                                        Click="IgnoreWindowButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            CornerRadius="24"
                            Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="Ignoradas"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Ocultas hasta que se cierre la app"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" />
                            </StackPanel>
                            <ListBox x:Name="IgnoredWindowsList"
                                     Grid.Row="2"
                                     Style="{StaticResource CleanListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                CornerRadius="16"
                                                Background="#0A0C10"
                                                BorderBrush="#17202C"
                                                BorderThickness="1"
                                                Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="82" />
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AppName}"
                                                               Foreground="{StaticResource TextMuted}"
                                                               FontSize="11"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Button Grid.Column="2"
                                                        Content="Restaurar"
                                                        Style="{StaticResource PillButton}"
                                                        Tag="{Binding}"
                                                        Click="RestoreWindowButton_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="AboutPanel" Visibility="Collapsed">
                    <Border Width="460"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            CornerRadius="26"
                            Background="{StaticResource SurfaceRaised}"
                            BorderBrush="{StaticResource BorderSoft}"
                            BorderThickness="1"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="Minimal Switcher"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock x:Name="VersionText"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="13"
                                       TextAlignment="Center"
                                       Margin="0,6,0,22" />

                            <Border CornerRadius="18"
                                    Background="#0A0D12"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Padding="16">
                                <StackPanel>
                                    <TextBlock Text="Distribucion"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="Las versiones y notas se publican en GitHub Releases."
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,4,0,14" />
                                    <UniformGrid Columns="2">
                                        <Button Content="Repositorio"
                                                Style="{StaticResource PillButton}"
                                                Margin="0,0,6,0"
                                                Click="OpenRepositoryButton_Click" />
                                        <Button Content="Changelog"
                                                Style="{StaticResource PillButton}"
                                                Margin="6,0,0,0"
                                                Click="OpenChangelogButton_Click" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border CornerRadius="18"
                                    Background="#0A0D12"
                                    BorderBrush="{StaticResource BorderSoft}"
                                    BorderThickness="1"
                                    Padding="16"
                                    Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Actualizaciones"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="UpdateStatusText"
                                               Text="Las actualizaciones se publican como instaladores en GitHub Releases."
                                               Foreground="{StaticResource TextMuted}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
